{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project 137 Claim",
  "type": "object",
  "required": [
    "id",
    "statement",
    "grade",
    "domain",
    "claim_type",
    "status",
    "limitations",
    "sources",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "X"
      ]
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exhibit_chapters": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 19
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}